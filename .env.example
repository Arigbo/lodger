# Copy to .env.local and fill in the values you need.
# Only NEXT_PUBLIC_* variables are exposed to the browser.

# --- Site ---------------------------------------------------------------
# Canonical public URL (used for metadata, sitemap, robots and JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Send the Content-Security-Policy as report-only (debugging escape hatch).
CSP_REPORT_ONLY=false

# --- Firebase Admin SDK (server-side reads, API auth) -------------------
# Either provide the full service-account JSON…
FIREBASE_SERVICE_ACCOUNT=
# …or the individual fields.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=

# --- Media storage ------------------------------------------------------
# Where photos/videos are stored: "firebase" (default) or "cloudinary".
# See docs/media-storage.md for trade-offs and setup.
NEXT_PUBLIC_MEDIA_PROVIDER=firebase
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe -------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Country used when creating landlord Express accounts (default US).
STRIPE_CONNECT_COUNTRY=US

# --- AI image moderation (Google Gemini) --------------------------------
GOOGLE_GENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Rate limiting (Upstash Redis) --------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to true to enable rate limiting during local development.
RATE_LIMIT_ENABLED=false

# --- Email (Resend) -----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Lodger <notifications@lodger.com>"

# --- Admin console -------------------------------------------------------
# Comma-separated admin emails and allowed origins for /api/broadcast.
ADMIN_EMAILS=
ADMIN_ALLOWED_ORIGINS=https://lodger-admin.vercel.app

# --- Blog ---------------------------------------------------------------
NEXT_PUBLIC_BLOG_API_URL=https://lodger-blog.vercel.app/api/v1/posts
NEXT_PUBLIC_BLOG_URL=https://lodger-blog.vercel.app/post
