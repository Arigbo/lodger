rules_version = '2';

// Security model
// - Every collection is deny-by-default; access is granted per collection below.
// - `list` rules mirror `get` rules so queries must be constrained to the
//   caller (e.g. where('tenantId', '==', uid)) — otherwise they are rejected.
// - Admins are managed out-of-band (Firebase console / Admin SDK) by creating
//   a doc in /admin_users/{uid}. Clients can never grant themselves admin.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'admin@lodger.com' ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
      );
    }

    function changes(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Admins can read and write everything.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /admin_users/{userId} {
      // A user may check whether they are an admin; nobody may self-promote.
      allow get: if isSelf(userId);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId)
        && request.resource.data.role in ['student', 'landlord']
        && !('banned' in request.resource.data);
      // Role and moderation flags can only be changed by admins / the server.
      allow update: if isSelf(userId) && !changes(['role', 'banned']);
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /properties/{propertyId} {
      // Listings are public (public pages and real-time listeners).
      allow read: if true;
      allow create: if signedIn() && request.resource.data.landlordId == request.auth.uid;
      // Landlord can edit; the current tenant may only release the property.
      allow update: if signedIn() && (
        (resource.data.landlordId == request.auth.uid && request.resource.data.landlordId == request.auth.uid) ||
        (resource.data.currentTenantId == request.auth.uid &&
          request.resource.data.status == 'available' &&
          request.resource.data.currentTenantId == null &&
          request.resource.data.leaseStartDate == null &&
          !changes(['landlordId', 'price', 'currency', 'title']))
      );
      allow delete: if signedIn() && resource.data.landlordId == request.auth.uid;
    }

    // Unpublished listings: private to the landlord who is writing them.
    match /propertyDrafts/{draftId} {
      allow read, delete: if signedIn() && resource.data.landlordId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.landlordId == request.auth.uid;
      allow update: if signedIn() && resource.data.landlordId == request.auth.uid
        && request.resource.data.landlordId == request.auth.uid;
    }

    match /rentalApplications/{applicationId} {
      function isApplicationParty() {
        return resource.data.tenantId == request.auth.uid ||
               resource.data.landlordId == request.auth.uid;
      }
      allow get: if signedIn() && (
        isApplicationParty() ||
        get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.landlordId == request.auth.uid
      );
      allow list: if signedIn() && isApplicationParty();
      allow create: if signedIn() && request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if signedIn() && (
        isApplicationParty() ||
        get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.landlordId == request.auth.uid
      );
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // Notifications are sent client-side between users; keep the shape strict.
      allow create: if signedIn()
        && request.resource.data.read == false
        && request.resource.data.userId is string;
      // Recipients may only toggle `read`.
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /leaseAgreements/{leaseId} {
      function isParticipant() {
        return request.auth.uid == resource.data.landlordId ||
               request.auth.uid == resource.data.tenantId;
      }
      allow read: if signedIn() && isParticipant();
      allow create: if signedIn() && (
        request.resource.data.landlordId == request.auth.uid ||
        request.resource.data.tenantId == request.auth.uid
      );
      allow update: if signedIn() && isParticipant();
      allow delete: if signedIn() && isParticipant() &&
        resource.data.status != 'active' &&
        resource.data.landlordSigned == false &&
        resource.data.tenantSigned == false;
    }

    match /userReports/{reportId} {
      // Reports are write-only for users; admins review them.
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
    }

    match /propertyReviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if signedIn() && resource.data.tenantId == request.auth.uid;
    }

    match /maintenanceRequests/{requestId} {
      function isRequestParty() {
        return resource.data.landlordId == request.auth.uid ||
               resource.data.tenantId == request.auth.uid;
      }
      allow read: if signedIn() && isRequestParty();
      allow create: if signedIn() && request.resource.data.tenantId == request.auth.uid;
      allow update: if signedIn() && isRequestParty();
    }

    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.participantIds;
    }

    match /transactions/{transactionId} {
      function isTransactionParty() {
        return resource.data.landlordId == request.auth.uid ||
               resource.data.tenantId == request.auth.uid;
      }
      allow read: if signedIn() && isTransactionParty();
      allow create: if signedIn() && (
        request.resource.data.landlordId == request.auth.uid ||
        request.resource.data.tenantId == request.auth.uid
      );
      allow update: if signedIn() && isTransactionParty();
      allow delete: if false;
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow create: if signedIn();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn();
    }
  }
}
